{
  "name": "skate20XX",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:movement": "node scripts/testGroup.mjs movement",
    "test:characters": "node scripts/testGroup.mjs characters",
    "test:world": "node scripts/testGroup.mjs world",
    "test:ui": "node scripts/testGroup.mjs ui",
    "test:game": "node scripts/testGroup.mjs game",
    "bench": "node --experimental-strip-types scripts/benchmark.ts --split-render --prepare",
    "bench:rider": "node --experimental-strip-types scripts/benchmarkRider.ts",
    "bench:world": "node --experimental-strip-types scripts/benchmarkWorld.ts",
    "dev:dlc": "node scripts/dlc.mjs dev",
    "build:dlc": "node scripts/dlc.mjs build",
    "test:dlc": "node scripts/dlc.mjs test"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0"
  }
}
